    { "se": "open_path" },
    { "say": "open_water" },
    { "transfer": { "map": "field_water", "x": 14, "y": 3, "dir": "down" } }
  ],
  "boss_wind": [
    { "bgmStop": 600 },
    { "wait": 300 },
    { "say": "boss_pre_wind" },
    { "battle": { "enemies": ["boss_wind"], "area": "tower" } },
    { "say": "boss_down_wind" },
    { "flag": "boss_wind" },
